  "item": [
    {
      "name": "random joke",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is a single joke object with the expected fields\", function () {",
              "    const joke = pm.response.json();",
              "    pm.expect(joke).to.be.an('object');",
              "    pm.expect(joke).to.have.property('id').that.is.a('number');",
              "    pm.expect(joke).to.have.property('type').that.is.a('string');",
              "    pm.expect(joke).to.have.property('setup').that.is.a('string');",
              "    pm.expect(joke).to.have.property('punchline').that.is.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/random_joke",
          "host": ["{{base_url}}"],
          "path": ["random_joke"]
        }
      },
      "response": []
    },
