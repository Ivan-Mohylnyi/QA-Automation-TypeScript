              "});",
              "",
              "pm.test(\"Response is an array of exactly 10 jokes\", function () {",
              "    const jokes = pm.response.json();",
              "    pm.expect(jokes).to.be.an('array').with.lengthOf(10);",
              "    jokes.forEach((joke) => {",
              "        pm.expect(joke).to.have.property('id');",
              "        pm.expect(joke).to.have.property('setup');",
              "        pm.expect(joke).to.have.property('punchline');",
